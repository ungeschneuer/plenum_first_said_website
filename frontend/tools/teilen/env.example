# Kopie als frontend/.env.teilen anlegen und ausfüllen. Die Datei ist in .gitignore und gelangt nie ins Repository.

# Instagram (Business- oder Creator-Konto, Berechtigung instagram_content_publish)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# INSTAGRAM_API_HOST=graph.facebook.com   (mit Instagram-Login: graph.instagram.com)
# INSTAGRAM_API_VERSION=v23.0

# GitHub: Instagram lädt die Bilder von einer öffentlichen Adresse; das Werkzeug legt sie im Release "teilen" ab.
# Fein granularer Token nur für dieses Repository mit "Contents: Read and write".
GITHUB_TOKEN=
# GITHUB_REPOSITORY=ungeschneuer/plenum_first_said_website

# LinkedIn (w_member_social für das eigene Profil, w_organization_social für eine Unternehmensseite)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR=urn:li:person:
# LINKEDIN_VERSION=202510

# Andere Datenquelle, etwa ein lokaler Export: TEILEN_DATA_URL=http://localhost:8000
